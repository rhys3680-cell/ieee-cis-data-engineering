# 저장소 안에서는 항상 LF 로 보관한다.
# Windows 로컬과 Linux CI 사이의 줄바꿈 차이로 인한 가짜 diff 를 막는다.
* text=auto eol=lf

# 셸 스크립트는 Windows 에서도 LF 유지 (CRLF 면 실행 불가)
*.sh text eol=lf

# Windows 전용 스크립트는 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# 바이너리 — 변환 금지
*.parquet binary
*.zip binary
*.png binary
*.jpg binary
*.pkl binary
*.joblib binary

# 자동 생성 파일 — diff 노이즈 축소
uv.lock linguist-generated=true