# 실제 값을 채운 뒤 .env 로 복사해서 사용 (.env 는 커밋되지 않음)
# cp .env.example .env

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-northeast3
GCS_BUCKET=your-bucket-name

# --- BigQuery 데이터셋 ---
# raw만 여기서 정한다. staging/mart는 dbt가 만들며 이름은
# dbt/profiles.yml의 dataset에 dbt_project.yml의 +schema 가 붙는다.
BQ_DATASET_RAW=ieee_raw

# --- 로컬 경로 ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# --- 로깅 ---
LOG_LEVEL=INFO