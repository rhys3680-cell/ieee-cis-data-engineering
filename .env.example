# 실제 값을 채운 뒤 .env 로 복사해서 사용 (.env 는 커밋되지 않음)
# cp .env.example .env

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-northeast3
GCS_BUCKET=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=config/gcp-key.json

# --- BigQuery 데이터셋 ---
BQ_DATASET_RAW=ieee_raw
BQ_DATASET_STAGING=ieee_staging
BQ_DATASET_MART=ieee_mart

# --- 로컬 경로 ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# --- 파티션 기준일 ---
# TransactionDT 는 이 시각으로부터의 초 오프셋으로 해석한다.
TRANSACTION_DT_ORIGIN=2017-11-30

# --- 로깅 ---
LOG_LEVEL=INFO