# 실제 값을 채운 뒤 profiles.yml 로 복사해서 사용 (profiles.yml 은 커밋되지 않음)
# cp profiles.yml.example profiles.yml

ieee_cis:
  target: dev
  outputs:
    dev:
      type: bigquery
      # 서비스 계정 키 대신 gcloud ADC를 쓴다.
      # 키 파일을 주고 받지 않는 편이 안전하다.
      #   gcloud auth application-default login
      method: oauth
      project: your-gcp-project-id
      # dbt 는 이 이름에 +schema 를 접미사로 붙여 dev_staging, dev_mart 를
      # 만든다. 여러 사람이 한 웨어하우스를 공유해도 서로 침범하지 않도록
      # 하는 관례다. 운영 타겟을 추가하면 prod_staging 이 된다.
      dataset: dev
      # ieee_raw 데이터셋 및 GCS 버킷과 같은 리전이어야 한다.
      location: asia-northeast3
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      priority: interactive